{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mbongui-reservations",
  "main": "backend/worker.mjs",
  "compatibility_date": "2026-10-20",
  "vars": {
    "ALLOWED_ORIGINS": "https://le-mbongui.vercel.app,https://le-mbongui.bernisorphe.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mbongui-reservations",
      "database_id": "af26bc39-797b-4cdc-9a94-eb9156fa037f"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
